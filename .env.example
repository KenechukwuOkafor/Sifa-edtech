# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Site -------------------------------------------------------------------
# Absolute origin, used for metadata and OG URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Service role key. Server-only: it bypasses row level security and must never
# be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=

# Must be an address on a domain you have verified in Resend.
RESEND_FROM_EMAIL=Sifa <notifications@sifa.africa>

# Where new lead notifications are delivered.
RESEND_TO_EMAIL=hello@sifa.africa
